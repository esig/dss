			<xs:enumeration value="CAdES_V2" />
			<xs:enumeration value="CAdES_V3" />
			<xs:enumeration value="CAdES_DETACHED" />
			<xs:enumeration value="JAdES" />
			<xs:enumeration value="CB_AdES" />
			<xs:enumeration value="PAdES" />

