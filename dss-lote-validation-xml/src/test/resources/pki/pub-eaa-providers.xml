    <!-- National RootCA certificate-->
    <certificate>
        <serialNumber>100000</serialNumber>
        <subject>Test-RootCA</subject>
        <organization>Test Pub-EAA Trusted Entity 1</organization>
        <country>ZZ</country>
        <issuer serialNumber="100000">Test-RootCA</issuer>
        <notBefore year="-10"/>
        <notAfter year="10"/>
        <keyAlgo encryption="RSA" length="4096"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>crlSign</keyUsage>
