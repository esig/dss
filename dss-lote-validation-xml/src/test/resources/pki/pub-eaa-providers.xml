<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<pki xmlns="http://pki-factory.nowina.lu/pki-factory" name="pub-eaa-providers">

    <!-- LoTE Signer -->
    <certificate>
        <serialNumber>10</serialNumber>
        <subject>LoTE-Signer</subject>
        <organization>EU Digital Ministry</organization>
        <country>EU</country>
        <issuer serialNumber="10">LoTE-Signer</issuer>
        <notBefore year="-10"/>
        <notAfter year="10"/>
        <keyAlgo encryption="RSA" length="4096"/>
        <digestAlgo>SHA256</digestAlgo>
        <keyUsages>
            <keyUsage>digitalSignature</keyUsage>
            <keyUsage>nonRepudiation</keyUsage>
        </keyUsages>
        <ca/>
    </certificate>

    <!-- LoLoTE Signer -->
